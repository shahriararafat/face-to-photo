# Optional. Public folders under ~100 photos work without it.
# For larger folders, enable the Drive API and paste a free API key.
GOOGLE_DRIVE_API_KEY=

# auto | insightface | sface | haar
# auto uses ArcFace when InsightFace is installed, otherwise SFace, otherwise Haar.
FACE_ENGINE=auto

MAX_IMAGE_EDGE=1600
INDEX_CONCURRENCY=3
MAX_PHOTOS=10000
